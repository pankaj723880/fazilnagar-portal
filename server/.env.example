# ====================================================================
# Fazilnagar News & Civic Portal — Server Environment Variables (Render)
# Note: Keep all real secrets in Render dashboard. Never commit secrets.
# ====================================================================

# Port and Environment
PORT=5000
NODE_ENV=production

# MongoDB Atlas Connection URI
MONGO_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/fazilnagar_db?retryWrites=true&w=majority

# JWT Session Secret (Use a cryptographically secure 64+ char random hex string)
JWT_SECRET=your_super_secret_64_character_hex_key_here

# Frontend Application Origin & CORS (Comma-separated for multiple origins)
CLIENT_URL=https://www.fazilnagar.me
ALLOWED_ORIGINS=https://www.fazilnagar.me,https://fazilnagar.me,https://fazilnagar.vercel.app,http://localhost:5173

# ====================================================================
# Google Identity Services / OAuth 2.0 Web Client (Phase 2)
# Obtain from Google Cloud Console -> APIs & Services -> Credentials
# ====================================================================
GOOGLE_CLIENT_ID=your_google_oauth_web_client_id.apps.googleusercontent.com

# ====================================================================
# SMTP Email Transport Settings (Nodemailer for OTP Delivery - Phase 5)
# Examples: Gmail (smtp.gmail.com), Brevo/Sendinblue, Resend, or AWS SES
# ====================================================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_verified_sender_email@gmail.com
SMTP_PASS=your_app_specific_password_or_smtp_key
SMTP_FROM="Fazilnagar Town Portal" <no-reply@fazilnagar.me>

# ====================================================================
# Default Administrator Account Seed
# ====================================================================
ADMIN_EMAIL=admin@fazilnagar.com
ADMIN_PASSWORD=YourStrongAdminPassword2026!
ADMIN_NAME=Admin

# ====================================================================
# Google Drive Media & Attachment Storage (Optional / Server-side)
# Required for Google Drive file uploads in Town Messaging & CMS
# ====================================================================
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret_here
GOOGLE_DRIVE_REFRESH_TOKEN=your_google_drive_refresh_token_here
GOOGLE_DRIVE_REDIRECT_URI=https://fazilnagar-portal.onrender.com/api/google-drive/oauth/callback
BACKEND_URL=https://fazilnagar-portal.onrender.com
FRONTEND_URL=https://www.fazilnagar.me

